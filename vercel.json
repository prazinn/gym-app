{
  "version": 2,
  "builds": [
    {
      "src": "src/app.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["views/**", "public/**", "prisma/**"]
      }
    }
  ],
  "functions": {
    "src/app.js": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/app.js"
    }
  ]
}