<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'GymTrack' %></title>
  <meta name="description" content="GymTrack — Modern Gym Attendance Management System" />

  <!-- Bootstrap 5 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css" />
  <%- typeof extraHead !== 'undefined' ? extraHead : '' %>
</head>
<body>

<!-- ── Sidebar ───────────────────────────────────────────────── -->
<div class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <div class="brand-icon"><i class="bi bi-lightning-charge-fill"></i></div>
    <span class="brand-name">GymTrack</span>
  </div>

  <nav class="sidebar-nav">
    <div class="nav-section-label">Main</div>
    <a href="/dashboard" class="nav-link-item <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
      <i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span>
    </a>
    <a href="/members" class="nav-link-item <%= typeof activePage !== 'undefined' && activePage === 'members' ? 'active' : '' %>">
      <i class="bi bi-people-fill"></i><span>Members</span>
    </a>
    <a href="/attendance/scan" class="nav-link-item <%= typeof activePage !== 'undefined' && activePage === 'scan' ? 'active' : '' %>">
      <i class="bi bi-qr-code-scan"></i><span>Scan QR</span>
    </a>
    <a href="/attendance/logs" class="nav-link-item <%= typeof activePage !== 'undefined' && activePage === 'logs' ? 'active' : '' %>">
      <i class="bi bi-journal-text"></i><span>Attendance Logs</span>
    </a>

    <div class="nav-section-label mt-3">Manage</div>
    <a href="/plans" class="nav-link-item <%= typeof activePage !== 'undefined' && activePage === 'plans' ? 'active' : '' %>">
      <i class="bi bi-card-checklist"></i><span>Plans</span>
    </a>
    <a href="/reports/export?fmt=csv" class="nav-link-item" id="nav-export">
      <i class="bi bi-download"></i><span>Export CSV</span>
    </a>
  </nav>

  <div class="sidebar-footer">
    <div class="user-info">
      <div class="user-avatar"><%= typeof user !== 'undefined' && user ? user.charAt(0).toUpperCase() : 'U' %></div>
      <div class="user-details">
        <div class="user-name"><%= typeof user !== 'undefined' ? user : 'User' %></div>
        <div class="user-role badge-role"><%= typeof role !== 'undefined' ? role : 'staff' %></div>
      </div>
    </div>
    <a href="/auth/logout" class="btn-logout" title="Logout"><i class="bi bi-box-arrow-right"></i></a>
  </div>
</div>

<!-- ── Main Wrapper ───────────────────────────────────────────── -->
<div class="main-wrapper" id="mainWrapper">

  <!-- Top Bar -->
  <header class="topbar">
    <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
      <i class="bi bi-list"></i>
    </button>
    <div class="topbar-title"><%= typeof title !== 'undefined' ? title.split('—')[0].trim() : 'GymTrack' %></div>
    <div class="topbar-actions">
      <a href="/attendance/scan" class="btn btn-sm btn-accent" id="topbar-scan-btn">
        <i class="bi bi-qr-code-scan me-1"></i>Scan
      </a>
    </div>
  </header>

  <!-- Flash Messages -->
  <div class="flash-container px-4 pt-3">
    <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
      <% errors.forEach(function(e) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-2"></i><%= e %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% }); %>
    <% } %>
    <% if (typeof success !== 'undefined' && success && success.length) { %>
      <% success.forEach(function(s) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <i class="bi bi-check-circle-fill me-2"></i><%= s %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% }); %>
    <% } %>
  </div>

  <!-- Page Content -->
  <main class="page-content">
    <%- body %>
  </main>

</div><!-- /main-wrapper -->

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- Sidebar Toggle -->
<script>
  const toggle = document.getElementById('sidebarToggle');
  const sidebar = document.getElementById('sidebar');
  const wrapper = document.getElementById('mainWrapper');
  toggle && toggle.addEventListener('click', () => {
    sidebar.classList.toggle('collapsed');
    wrapper.classList.toggle('expanded');
  });
  // Auto-close flash alerts after 5s
  setTimeout(() => {
    document.querySelectorAll('.alert').forEach(a => {
      const bsAlert = bootstrap.Alert.getOrCreateInstance(a);
      bsAlert && bsAlert.close();
    });
  }, 5000);
</script>
<%- typeof extraScripts !== 'undefined' ? extraScripts : '' %>
</body>
</html>
