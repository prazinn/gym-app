<% layout('/layout/base') %>
<% activePage = 'members' %>

<div class="container-fluid px-4 py-4">

  <!-- Header -->
  <div class="page-header mb-4">
    <div class="d-flex align-items-center gap-3">
      <a href="/members" class="btn btn-ghost btn-icon" id="btn-back-profile"><i class="bi bi-arrow-left"></i></a>
      <div>
        <h1 class="page-title mb-0"><%= member.fullName %></h1>
        <code class="member-code mt-1 d-inline-block"><%= member.memberCode %></code>
      </div>
    </div>
    <div class="d-flex gap-2">
      <a href="/members/<%= member.id %>/edit" class="btn btn-ghost" id="btn-edit-profile">
        <i class="bi bi-pencil me-1"></i>Edit
      </a>
      <% if (role === 'admin') { %>
        <form method="POST" action="/members/<%= member.id %>/delete" id="form-delete-profile"
              onsubmit="return confirm('Delete this member? This cannot be undone.')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-danger-ghost" id="btn-delete-profile">
            <i class="bi bi-trash me-1"></i>Delete
          </button>
        </form>
      <% } %>
    </div>
  </div>

  <div class="row g-4">

    <!-- Member Card -->
    <div class="col-12 col-lg-4">
      <div class="card-glass">
        <div class="card-glass__body text-center pb-4">
          <div class="member-avatar-lg mx-auto mb-3"><%= member.fullName.charAt(0).toUpperCase() %></div>
          <h2 class="h5 fw-bold mb-1"><%= member.fullName %></h2>
          <p class="member-email mb-3"><%= member.email %></p>
          
          <div class="mb-3">
            <span class="badge-status badge-status--<%= member.status %>">
              <%= member.status.charAt(0).toUpperCase() + member.status.slice(1) %> Member
            </span>
          </div>

          <div class="d-flex gap-2 justify-content-center mb-4">
            <button class="btn btn-sm btn-accent" data-bs-toggle="modal" data-bs-target="#renewModal">
              <i class="bi bi-arrow-repeat me-1"></i>Renew Plan
            </button>
            <button class="btn btn-sm btn-ghost" data-bs-toggle="modal" data-bs-target="#statusModal">
              <i class="bi bi-shield-check me-1"></i>Change Status
            </button>
          </div>

          <div class="member-stats-grid mt-3">
            <div class="member-stat">
              <div class="member-stat__val"><%= member.heightCm %><span>cm</span></div>
              <div class="member-stat__label">Height</div>
            </div>
            <div class="member-stat">
              <div class="member-stat__val"><%= member.weightKg %><span>kg</span></div>
              <div class="member-stat__label">Weight</div>
            </div>
            <div class="member-stat">
              <div class="member-stat__val" id="profileBmi">—</div>
              <div class="member-stat__label">BMI</div>
            </div>
          </div>

          <hr class="border-subtle my-4" />

          <dl class="member-dl text-start">
            <div class="member-dl__row">
              <dt><i class="bi bi-phone me-2"></i>Phone</dt>
              <dd><%= member.phone || '—' %></dd>
            </div>
            <div class="member-dl__row">
              <dt><i class="bi bi-card-checklist me-2"></i>Plan</dt>
              <dd><span class="badge-plan"><%= member.planType %></span></dd>
            </div>
            <div class="member-dl__row">
              <dt><i class="bi bi-calendar-check me-2"></i>Started</dt>
              <dd><%= new Date(member.planStart).toLocaleDateString('en-US', {year:'numeric',month:'short',day:'numeric'}) %></dd>
            </div>
            <div class="member-dl__row">
              <dt><i class="bi bi-calendar-x me-2"></i>Expires</dt>
              <dd class="plan-date"><%= member.planEnd ? new Date(member.planEnd).toLocaleDateString('en-US', {year:'numeric',month:'short',day:'numeric'}) : 'No expiry' %></dd>
            </div>
            <div class="member-dl__row">
              <dt><i class="bi bi-clock me-2"></i>Joined</dt>
              <dd><%= new Date(member.createdAt).toLocaleDateString('en-US', {year:'numeric',month:'short',day:'numeric'}) %></dd>
            </div>
          </dl>
        </div>
      </div>
    </div>

    <!-- Middle Column: QR + Status History -->
    <div class="col-12 col-md-6 col-lg-4">
      <!-- QR Code Card -->
      <div class="card-glass mb-4">
        <div class="card-glass__header">
          <h2 class="card-glass__title"><i class="bi bi-qr-code me-2"></i>QR Code</h2>
        </div>
        <div class="card-glass__body text-center">
          <% if (member.qrCodePath) { %>
            <div class="qr-wrapper mx-auto mb-4">
              <img src="<%= member.qrCodePath %>" alt="QR Code for <%= member.memberCode %>" class="qr-img" id="qrImg" />
            </div>
          <% } else { %>
            <div class="empty-state py-3">
              <i class="bi bi-qr-code"></i>
              <p>QR not generated yet.</p>
            </div>
          <% } %>

          <div class="d-grid gap-2">
            <a href="/members/<%= member.id %>/qr" class="btn btn-accent" id="btn-download-qr">
              <i class="bi bi-download me-2"></i>Download QR PNG
            </a>
            <button class="btn btn-ghost" id="btn-regen-qr" onclick="regenQR(<%= member.id %>)">
              <i class="bi bi-arrow-clockwise me-2"></i>Regenerate QR
            </button>
          </div>
        </div>
      </div>

      <!-- Status History Timeline -->
      <div class="card-glass">
        <div class="card-glass__header">
          <h2 class="card-glass__title"><i class="bi bi-shield-check me-2"></i>Status History</h2>
          <button class="btn btn-sm btn-ghost" type="button" data-bs-toggle="collapse" data-bs-target="#statusHistoryCollapse">
            <i class="bi bi-chevron-expand"></i>
          </button>
        </div>
        <div class="collapse show" id="statusHistoryCollapse">
          <div class="card-glass__body p-0" style="max-height: 300px; overflow-y: auto;">
            <% if (member.statusLogs.length === 0) { %>
              <div class="empty-state py-4 text-center">
                <p class="text-muted small">No status changes recorded.</p>
              </div>
            <% } else { %>
              <ul class="visit-timeline p-3">
                <% member.statusLogs.forEach(function(log) { %>
                  <li class="visit-timeline__item">
                    <div class="visit-timeline__dot"></div>
                    <div class="visit-timeline__body">
                      <div class="d-flex justify-content-between align-items-center">
                        <span class="badge-status badge-status--<%= log.newStatus %>" style="font-size: 0.7rem;">
                          <%= log.newStatus.toUpperCase() %>
                        </span>
                        <span class="text-muted small"><%= new Date(log.createdAt).toLocaleDateString('en-US', {month:'short', day:'numeric'}) %></span>
                      </div>
                      <div class="fw-semibold small mt-1"><%= log.remarks %></div>
                      <div class="text-muted" style="font-size: 0.7rem;">Changed by: <%= log.changedBy %></div>
                    </div>
                  </li>
                <% }); %>
              </ul>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Attendance History -->
    <div class="col-12 col-md-6 col-lg-4">
      <div class="card-glass h-100">
        <div class="card-glass__header">
          <h2 class="card-glass__title"><i class="bi bi-journal-text me-2"></i>Recent Visits</h2>
          <span class="text-muted small"><%= member.attendanceLogs.length %> records</span>
        </div>
        <div class="card-glass__body p-0" style="max-height: 600px; overflow-y:auto;">
          <% if (member.attendanceLogs.length === 0) { %>
            <div class="empty-state py-4">
              <i class="bi bi-calendar-x"></i>
              <p>No visits recorded yet.</p>
            </div>
          <% } else { %>
            <ul class="visit-timeline">
              <% member.attendanceLogs.forEach(function(log) { %>
                <li class="visit-timeline__item">
                  <div class="visit-timeline__dot <%= log.checkOut ? '' : 'visit-timeline__dot--active' %>"></div>
                  <div class="visit-timeline__body">
                    <div class="fw-semibold small">
                      <%= new Date(log.checkIn).toLocaleDateString('en-US', {weekday:'short',month:'short',day:'numeric'}) %>
                    </div>
                    <div class="text-muted small">
                      In: <%= new Date(log.checkIn).toLocaleTimeString('en-US', {hour:'2-digit',minute:'2-digit'}) %>
                      <% if (log.checkOut) { %>
                        · Out: <%= new Date(log.checkOut).toLocaleTimeString('en-US', {hour:'2-digit',minute:'2-digit'}) %>
                      <% } else { %>
                        <span class="badge-status badge-status--active ms-1">Active</span>
                      <% } %>
                    </div>
                    <div class="text-muted small opacity-75"><%= log.method.replace('_', ' ') %></div>
                  </div>
                </li>
              <% }); %>
            </ul>
          <% } %>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Modal: Change Status -->
<div class="modal fade" id="statusModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-glass" style="background: #1e293b; border: 1px solid rgba(255,255,255,0.1);">
      <div class="modal-header border-bottom border-subtle">
        <h5 class="modal-title fw-bold"><i class="bi bi-shield-check me-2"></i>Change Member Status</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/members/<%= member.id %>/status" method="POST">
        <div class="modal-body">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="mb-3">
            <label class="form-label fw-semibold">New Status</label>
            <select name="status" class="form-select bg-dark text-white border-subtle">
              <option value="active" <%= member.status === 'active' ? 'selected' : '' %>>Active</option>
              <option value="inactive" <%= member.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
              <option value="expired" <%= member.status === 'expired' ? 'selected' : '' %>>Expired</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Remarks (Mandatory)</label>
            <textarea name="remarks" id="statusRemarks" class="form-control bg-dark text-white border-subtle" 
                      placeholder="e.g. Member on hold by request, Payment received, etc." required rows="3"></textarea>
          </div>
        </div>
        <div class="modal-footer border-top border-subtle">
          <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" id="btnStatusSave" class="btn btn-accent" disabled>Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Renew Plan -->
<div class="modal fade" id="renewModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-glass" style="background: #1e293b; border: 1px solid rgba(255,255,255,0.1);">
      <div class="modal-header border-bottom border-subtle">
        <h5 class="modal-title fw-bold"><i class="bi bi-arrow-repeat me-2"></i>Renew Subscription</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/members/<%= member.id %>/renew" method="POST">
        <div class="modal-body">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="mb-3">
            <label class="form-label fw-semibold">Select Plan</label>
            <select name="planType" id="renewPlanSelect" class="form-select bg-dark text-white border-subtle" required>
              <% plans.forEach(p => { %>
                <option value="<%= p.planName %>" data-days="<%= p.durationDays %>" <%= p.planName === member.planType ? 'selected' : '' %>>
                  <%= p.planName %> (<%= p.durationDays %> days)
                </option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">New End Date</label>
            <input type="date" name="planEnd" id="renewPlanEnd" class="form-control bg-dark text-white border-subtle" required />
            <p class="text-muted small mt-1">Suggested based on current status & plan duration.</p>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Remarks (Mandatory)</label>
            <textarea name="remarks" id="renewRemarks" class="form-control bg-dark text-white border-subtle" 
                      placeholder="e.g. Cash payment, Online transfer via eSewa" required rows="2"></textarea>
          </div>
        </div>
        <div class="modal-footer border-top border-subtle">
          <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" id="btnRenewSave" class="btn btn-accent" disabled>Complete Renewal</button>
        </div>
      </form>
    </div>
  </div>
</div>

<% extraScripts = `
<script>
  // BMI Calculation
  (function() {
    const h = ${member.heightCm} / 100;
    const w = ${member.weightKg};
    if (h && w) {
      document.getElementById('profileBmi').textContent = (w / (h * h)).toFixed(1);
    }
  })();

  // Remarks Validation for Status Modal
  const statusRemarks = document.getElementById('statusRemarks');
  const btnStatusSave = document.getElementById('btnStatusSave');
  statusRemarks.addEventListener('input', () => {
    btnStatusSave.disabled = statusRemarks.value.trim().length < 3;
  });

  // Remarks Validation for Renew Modal
  const renewRemarks = document.getElementById('renewRemarks');
  const btnRenewSave = document.getElementById('btnRenewSave');
  renewRemarks.addEventListener('input', () => {
    btnRenewSave.disabled = renewRemarks.value.trim().length < 3;
  });

  // Auto-calculate Renewal Date
  const renewPlanSelect = document.getElementById('renewPlanSelect');
  const renewPlanEnd = document.getElementById('renewPlanEnd');
  
  function updateSuggestedEndDate() {
    const days = parseInt(renewPlanSelect.options[renewPlanSelect.selectedIndex].dataset.days);
    const baseDate = new Date(); // Renewal usually starts from today
    // If current plan hasn't expired yet, we could also start from planEnd, 
    // but usually today is safer for standard gym ops.
    const currentEnd = new Date("${member.planEnd || new Date().toISOString()}");
    const startDate = currentEnd > new Date() ? currentEnd : new Date();
    
    startDate.setDate(startDate.getDate() + days);
    renewPlanEnd.value = startDate.toISOString().split('T')[0];
  }
  
  renewPlanSelect.addEventListener('change', updateSuggestedEndDate);
  document.getElementById('renewModal').addEventListener('shown.bs.modal', updateSuggestedEndDate);

  function regenQR(memberId) {
    const btn = document.getElementById('btn-regen-qr');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Regenerating…';
    fetch('/members/' + memberId + '/regen-qr', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'CSRF-Token': '${csrfToken}' },
      body: JSON.stringify({ _csrf: '${csrfToken}' })
    })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        const img = document.getElementById('qrImg');
        if (img) img.src = data.path + '?t=' + Date.now();
        btn.innerHTML = '<i class="bi bi-check-lg me-2"></i>Done!';
        setTimeout(() => { btn.innerHTML = '<i class="bi bi-arrow-clockwise me-2"></i>Regenerate QR'; btn.disabled = false; }, 2000);
      } else {
        alert('Failed: ' + data.error);
        btn.innerHTML = '<i class="bi bi-arrow-clockwise me-2"></i>Regenerate QR';
        btn.disabled = false;
      }
    })
    .catch(() => { btn.innerHTML = 'Error'; btn.disabled = false; });
  }
</script>
` %>

