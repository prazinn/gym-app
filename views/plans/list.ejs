<% layout('/layout/base') %>
<% activePage = 'plans' %>

<div class="container-fluid px-4 py-4">

  <div class="page-header mb-4">
    <div>
      <h1 class="page-title">Membership Plans</h1>
      <p class="page-subtitle">Manage your gym's subscription tiers.</p>
    </div>
    <% if (role === 'admin') { %>
      <button class="btn btn-accent" data-bs-toggle="modal" data-bs-target="#addPlanModal" id="btn-add-plan">
        <i class="bi bi-plus-lg me-2"></i>Add Plan
      </button>
    <% } %>
  </div>

  <% if (plans.length === 0) { %>
    <div class="empty-state card-glass py-5">
      <i class="bi bi-card-checklist"></i>
      <p>No plans created yet.</p>
      <% if (role === 'admin') { %>
        <button class="btn btn-accent mt-2" data-bs-toggle="modal" data-bs-target="#addPlanModal">Create First Plan</button>
      <% } %>
    </div>
  <% } else { %>
    <div class="row g-4">
      <% plans.forEach(function(plan, idx) {
        const accents = ['--purple','--cyan','--green','--orange'];
        const accent  = accents[idx % accents.length];
        const features = plan.features ? plan.features.split(',').map(f => f.trim()) : [];
      %>
        <div class="col-12 col-sm-6 col-xl-4">
          <div class="plan-card plan-card<%= accent %> <%= !plan.isActive ? 'plan-card--inactive' : '' %>">
            <div class="plan-card__header">
              <div class="d-flex justify-content-between align-items-start">
                <h2 class="plan-card__name"><%= plan.planName %></h2>
                <% if (!plan.isActive) { %>
                  <span class="badge bg-danger-subtle text-danger px-2 py-1 rounded-pill small" style="font-size: 10px;">INACTIVE</span>
                <% } else { %>
                  <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill small" style="font-size: 10px;">ACTIVE</span>
                <% } %>
              </div>
              <div class="plan-card__price">
                NRS <%= plan.price.toFixed(2) %>
                <span>/ <%= plan.durationDays %> days</span>
              </div>
            </div>
            <div class="plan-card__body">
              <% if (features.length > 0) { %>
                <ul class="plan-features">
                  <% features.forEach(function(f) { %>
                    <li><i class="bi bi-check-circle-fill me-2"></i><%= f %></li>
                  <% }); %>
                </ul>
              <% } else { %>
                <p class="text-muted small">No features listed.</p>
              <% } %>
            </div>
            <% if (role === 'admin') { %>
              <div class="plan-card__footer d-flex gap-2 pt-3 border-top border-subtle mt-3">
                <button
                  class="btn btn-sm btn-ghost flex-fill"
                  id="btn-edit-plan-<%= plan.id %>"
                  data-bs-toggle="modal"
                  data-bs-target="#editPlanModal"
                  data-id="<%= plan.id %>"
                  data-name="<%= plan.planName %>"
                  data-duration="<%= plan.durationDays %>"
                  data-price="<%= plan.price %>"
                  data-features="<%= plan.features || '' %>"
                  data-active="<%= plan.isActive %>">
                  <i class="bi bi-pencil me-1"></i>Edit
                </button>
                <form method="POST" action="/plans/<%= plan.id %>/delete" class="flex-fill"
                  id="form-delete-plan-<%= plan.id %>"
                  onsubmit="return confirm('Delete plan \"<%= plan.planName %>\"? This cannot be undone.')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="btn btn-sm btn-danger w-100" id="btn-delete-plan-<%= plan.id %>">
                    <i class="bi bi-trash me-1"></i>Delete
                  </button>
                </form>
              </div>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

</div>

<% if (role === 'admin') { %>

<!-- Add Plan Modal -->
<div class="modal fade" id="addPlanModal" tabindex="-1" aria-labelledby="addPlanModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-glass border-0">
      <form method="POST" action="/plans/add" id="addPlanForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="modal-header border-0">
          <h3 class="modal-title h6 fw-bold" id="addPlanModalLabel">
            <i class="bi bi-plus-circle me-2"></i>Create New Plan
          </h3>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label for="planName" class="form-label fw-semibold">Plan Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="planName" name="planName" required placeholder="e.g. Monthly" />
          </div>
          <div class="row g-3">
            <div class="col-6">
              <label for="durationDays" class="form-label fw-semibold">Duration (days) <span class="text-danger">*</span></label>
              <input type="number" class="form-control" id="durationDays" name="durationDays" min="1" required placeholder="30" />
            </div>
            <div class="col-6">
              <label for="price" class="form-label fw-semibold">Price (NRS) <span class="text-danger">*</span></label>
              <input type="number" class="form-control" id="price" name="price" min="0" step="0.01" required placeholder="2999" />
            </div>
          </div>
          <div class="mt-3">
            <label for="features" class="form-label fw-semibold">Features <span class="text-muted fw-normal">(comma-separated)</span></label>
            <input type="text" class="form-control" id="features" name="features"
              placeholder="Unlimited access, Locker, Personal trainer session" />
          </div>
        </div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-accent" id="btn-submit-plan">
            <i class="bi bi-check-lg me-1"></i>Create Plan
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Plan Modal -->
<div class="modal fade" id="editPlanModal" tabindex="-1" aria-labelledby="editPlanModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-glass border-0">
      <form method="POST" id="editPlanForm" action="/plans/0/edit">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="modal-header border-0">
          <h3 class="modal-title h6 fw-bold" id="editPlanModalLabel">
            <i class="bi bi-pencil me-2"></i>Edit Plan
          </h3>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label for="editPlanName" class="form-label fw-semibold">Plan Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="editPlanName" name="planName" required />
          </div>
          <div class="row g-3">
            <div class="col-6">
              <label for="editDurationDays" class="form-label fw-semibold">Duration (days) <span class="text-danger">*</span></label>
              <input type="number" class="form-control" id="editDurationDays" name="durationDays" min="1" required />
            </div>
            <div class="col-6">
              <label for="editPrice" class="form-label fw-semibold">Price (NRS) <span class="text-danger">*</span></label>
              <input type="number" class="form-control" id="editPrice" name="price" min="0" step="0.01" required />
            </div>
          </div>
          <div class="mt-3">
            <label for="editFeatures" class="form-label fw-semibold">Features <span class="text-muted fw-normal">(comma-separated)</span></label>
            <input type="text" class="form-control" id="editFeatures" name="features"
              placeholder="Unlimited access, Locker, Personal trainer session" />
          </div>
          <div class="form-check form-switch mt-4">
            <input class="form-check-input" type="checkbox" role="switch" id="editIsActive" name="isActive" checked>
            <label class="form-check-label fw-semibold" for="editIsActive">Active / Available for new members</label>
          </div>
        </div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-accent" id="btn-update-plan">
            <i class="bi bi-check-lg me-1"></i>Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<% extraScripts = `
<script>
  // Populate edit modal with plan data when triggered
  document.getElementById('editPlanModal').addEventListener('show.bs.modal', function (e) {
    const btn = e.relatedTarget;
    document.getElementById('editPlanName').value     = btn.dataset.name;
    document.getElementById('editDurationDays').value = btn.dataset.duration;
    document.getElementById('editPrice').value        = btn.dataset.price;
    document.getElementById('editFeatures').value     = btn.dataset.features;
    document.getElementById('editIsActive').checked   = btn.dataset.active === 'true';
    document.getElementById('editPlanForm').action    = '/plans/' + btn.dataset.id + '/edit';
  });
</script>
` %>

<% } %>
